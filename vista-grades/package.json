{
  "name": "vistagrades",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"next dev --hostname 127.0.0.1\" \"node --watch server/index.mjs\"",
    "build": "next build",
    "start": "concurrently -k \"next start --hostname 127.0.0.1\" \"node server/index.mjs\"",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "node scripts/check-browser.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "better-sqlite3": "13.0.3",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "stripe": "22.6.2",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.5",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
